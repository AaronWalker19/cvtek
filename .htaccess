RewriteEngine On

# Redirection de /cvtek vers /cvtek/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^cvtek$ cvtek/ [R=301,L]

# React Router - NE PAS rediriger les appels API vers index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/cvtek/api/
RewriteRule . /cvtek/index.html [L]