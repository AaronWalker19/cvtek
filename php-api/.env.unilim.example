# Configuration d'exemple pour Unilim SSO
# Copier dans le fichier php-api/.env

# Unilim SSO (OpenID Connect)
# CLIENT_ID: fourni par Unilim (ex: gupp)
# CLIENT_SECRET: À RÉCUPÉRER AUPRÈS DE UNILIM
# REDIRECT_URI: URL de callback après authentification Unilim

# Développement local
UNILIM_CLIENT_ID=gupp
UNILIM_CLIENT_SECRET=your_client_secret_here
UNILIM_REDIRECT_URI=http://localhost:3000/cvtek/auth/callback

# Production (exemple)
# UNILIM_CLIENT_ID=gupp
# UNILIM_CLIENT_SECRET=your_client_secret_here
# UNILIM_REDIRECT_URI=https://mmi.unilim.fr/cvtek/auth/callback

# Notes:
# - Le CLIENT_SECRET doit être conservé secret et ne jamais être commis dans Git
# - Ajouter .env au .gitignore si ce n'est pas déjà fait
# - Le REDIRECT_URI doit correspondre exactement à celui enregistré chez Unilim
